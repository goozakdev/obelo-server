{
  "id": "theaudiodb",
  "name": "TheAudioDB",
  "version": "1.0.1",
  "apiVersion": 1,
  "description": "Artist images (name-matched) and biographies. Fill-only supplement; requires an API key.",
  "docsUrl": "https://www.theaudiodb.com/api_guide.php",
  "provides": [
    {
      "kind": "metadata-provider",
      "kinds": ["music"],
      "role": "supplement",
      "class": "artwork",
      "capabilities": ["artwork-candidates"],
      "requiresSecret": true,
      "probe": {
        "kind": "artist",
        "title": "Radiohead",
        "artist": "Radiohead"
      }
    }
  ],
  "network": {
    "hosts": ["www.theaudiodb.com"]
  },
  "settings": {
    "requiresSecret": true,
    "defaultUrl": "https://www.theaudiodb.com/api/v1/json"
  }
}
